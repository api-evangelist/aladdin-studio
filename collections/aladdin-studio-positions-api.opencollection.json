{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aladdin Data Cloud Analytics Positions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.blackrock.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Positions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Aladdin Studio Get Portfolio Positions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blackrock.com/adc/v1/portfolios/:portfolioId/positions",
            "params": [
              {
                "name": "portfolioId",
                "value": "",
                "type": "path",
                "description": "Unique portfolio identifier"
              },
              {
                "name": "asOfDate",
                "value": "",
                "type": "query",
                "description": "Position date in YYYY-MM-DD format"
              }
            ]
          },
          "docs": "Retrieve current positions for a portfolio including security identifiers, market values, quantities, and weights."
        }
      ]
    }
  ],
  "bundled": true
}