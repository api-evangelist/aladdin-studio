{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aladdin Data Cloud Analytics Connections API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.blackrock.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Connections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Aladdin Studio List Data Cloud Connections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blackrock.com/adc/v1/connections"
          },
          "docs": "List available Aladdin Data Cloud connections for the authenticated user including Snowflake account details and available schemas."
        }
      ]
    }
  ],
  "bundled": true
}