{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aladdin Data Cloud Analytics Queries API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.blackrock.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Queries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Aladdin Studio Execute Data Cloud Query",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.blackrock.com/adc/v1/connections/:connectionId/query",
            "params": [
              {
                "name": "connectionId",
                "value": "",
                "type": "path",
                "description": "Data Cloud connection identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute a SQL query against the Aladdin Data Cloud Snowflake database and return results. Supports pagination for large result sets."
        }
      ]
    }
  ],
  "bundled": true
}